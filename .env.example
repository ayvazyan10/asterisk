# Example secrets file. In production, copy to ~/.asterisk/secrets.env
# (chmod 600). Asterisk's `configure` wizard writes this file for you.
# Never commit a real secrets.env.

# Optional — only if provider=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only if bots.telegram.enabled
ASTERISK_TELEGRAM_BOT_TOKEN=...

# Optional — only if bots.whatsapp.enabled and transport=meta-cloud
ASTERISK_WHATSAPP_META_TOKEN=...
ASTERISK_WHATSAPP_VERIFY_TOKEN=...
