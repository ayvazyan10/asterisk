#!/usr/bin/env bash
# Asterisk dispatcher — REPL by default, daemon subcommands handled here.
# Subcommands: start | stop | restart | status | logs | configure | web | update
# No subcommand → interactive REPL.

set -euo pipefail

# Resolve through symlinks so `asterisk` works when this file is symlinked
# into ~/.local/bin or /usr/local/bin from the real install dir.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" = /* ]]; then
    SOURCE="$TARGET"
  else
    SOURCE="$(cd -P "$(dirname "$SOURCE")" && pwd)/$TARGET"
  fi
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# The bundles are built with `target: bun` and every entrypoint below execs
# `bun`, so a missing Bun is a hard stop rather than a fallback to node. Worth
# saying out loud: installing from npm does not bring Bun with it.
if ! command -v bun >/dev/null 2>&1; then
  cat >&2 <<'MISSING_BUN'
asterisk: Bun is required but was not found on PATH.

Asterisk's bundles target the Bun runtime, so Node cannot run them.
Install Bun and try again:

  curl -fsSL https://bun.sh/install | bash

Other install methods: https://bun.sh
MISSING_BUN
  exit 127
fi
DIST_CLI="$ROOT/dist/cli.js"
DIST_DAEMON="$ROOT/dist/daemon.js"
DIST_CONTROL="$ROOT/dist/control.js"
DIST_CONFIGURE="$ROOT/dist/configure.js"
DIST_UPDATE="$ROOT/dist/update.js"
DIST_WEB="$ROOT/dist/web.js"
DIST_ACP="$ROOT/dist/acp.js"
SRC_CLI="$ROOT/src/entrypoints/cli.tsx"
SRC_CONTROL="$ROOT/src/entrypoints/control.ts"
SRC_CONFIGURE="$ROOT/src/entrypoints/configure.tsx"
SRC_UPDATE="$ROOT/src/entrypoints/update.ts"
SRC_WEB="$ROOT/src/entrypoints/web.ts"
SRC_ACP="$ROOT/src/entrypoints/acp.ts"

# Sensible defaults — local Ollama, telemetry off.
export OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-http://127.0.0.1:11434}"
export OLLAMA_MODEL="${OLLAMA_MODEL:-carstenuhlig/omnicoder-9b:q8_0}"
export OLLAMA_CONTEXT_WINDOW="${OLLAMA_CONTEXT_WINDOW:-65536}"

cmd="${1:-repl}"
[[ $# -gt 0 ]] && shift || true

run_cli() {
  if [[ -f "$DIST_CLI" ]]; then
    exec bun "$DIST_CLI" "$@"
  fi
  exec bun "$SRC_CLI" "$@"
}

run_control() {
  local sub="$1"
  shift || true
  if [[ -f "$DIST_CONTROL" ]]; then
    exec bun "$DIST_CONTROL" "$sub" "$@"
  fi
  exec bun "$SRC_CONTROL" "$sub" "$@"
}

run_configure() {
  if [[ -f "$DIST_CONFIGURE" ]]; then
    exec bun "$DIST_CONFIGURE" "$@"
  fi
  exec bun "$SRC_CONFIGURE" "$@"
}

run_update() {
  if [[ -f "$DIST_UPDATE" ]]; then
    exec bun "$DIST_UPDATE" "$@"
  fi
  exec bun "$SRC_UPDATE" "$@"
}

run_web() {
  if [[ -f "$DIST_WEB" ]]; then
    exec bun "$DIST_WEB" "$@"
  fi
  exec bun "$SRC_WEB" "$@"
}

run_acp() {
  if [[ -f "$DIST_ACP" ]]; then
    exec bun "$DIST_ACP" "$@"
  fi
  exec bun "$SRC_ACP" "$@"
}

case "$cmd" in
  repl|"")
    run_cli "$@"
    ;;
  start|stop|restart|status|logs)
    run_control "$cmd" "$@"
    ;;
  configure)
    run_configure "$@"
    ;;
  web)
    run_web "$@"
    ;;
  acp)
    run_acp "$@"
    ;;
  update)
    run_update "$@"
    ;;
  --help|-h|help)
    cat <<'USAGE'
asterisk — lightweight, personal AI assistant

Usage:
  asterisk                Start the interactive REPL
  asterisk start          Start the daemon
  asterisk stop           Stop the daemon
  asterisk restart        Restart the daemon
  asterisk status         Show daemon status
  asterisk logs [N]       Tail last N daemon log lines (default 50)
  asterisk configure      Interactive config wizard
  asterisk web [flags]    Web control panel for every setting
  asterisk acp            Serve the Agent Client Protocol on stdio (for editors)
  asterisk update         Self-update to the latest version

Web panel flags:
  --port <n>              Override the configured port (default 4321)
  --host <addr>           Override the bind address (default 127.0.0.1)
  --no-auth               Disable token auth (loopback binds only)
  --no-open               Do not launch a browser
  --print-token           Issue a token, print it, and exit

Environment:
  OLLAMA_BASE_URL         Ollama HTTP base URL (default http://127.0.0.1:11434)
  OLLAMA_MODEL            Ollama model name (default qwen3.5:9b-q8-max)
  ASTERISK_PROVIDER       Force provider: ollama | anthropic
  ANTHROPIC_API_KEY       Required for Anthropic provider
  ASTERISK_HOME           Override config root (default ~/.asterisk)
USAGE
    ;;
  *)
    echo "asterisk: unknown subcommand '$cmd' (try 'asterisk help')" >&2
    exit 2
    ;;
esac
