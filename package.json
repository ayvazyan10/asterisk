{
  "name": "@ayvazyan10/asterisk",
  "version": "0.2.0",
  "description": "Asterisk \u2014 lightweight, personal AI assistant with Ollama-first model support, daemon controls, and Telegram/WhatsApp bot bridges.",
  "license": "Apache-2.0",
  "type": "module",
  "private": false,
  "bin": {
    "asterisk": "./bin/asterisk"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayvazyan10/asterisk.git"
  },
  "homepage": "https://github.com/ayvazyan10/asterisk#readme",
  "bugs": {
    "url": "https://github.com/ayvazyan10/asterisk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "dist/",
    "!dist/**/*.map",
    "src/",
    "scripts/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "PROVENANCE.md"
  ],
  "os": [
    "linux",
    "darwin"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "bun src/entrypoints/cli.tsx",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.0",
    "execa": "^9.5.0",
    "grammy": "^1.30.0",
    "ink": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "pino": "^9.5.0",
    "playwright": "^1.59.1",
    "react": "^18.3.0",
    "tinyglobby": "^0.2.16",
    "undici": "^7.3.0",
    "whatsapp-web.js": "^1.26.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.2.0",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "ollama",
    "anthropic",
    "telegram-bot",
    "whatsapp-bot",
    "local-first"
  ]
}
